{
  "name": "@gbthui/dsh-auto-review",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that uses a reviewer model to answer approval requests before interactive approval.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "agent",
    "approval",
    "auto-review"
  ],
  "homepage": "https://github.com/gbthui/dsh-auto-review#readme",
  "bugs": {
    "url": "https://github.com/gbthui/dsh-auto-review/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbthui/dsh-auto-review.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "c8": "12.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "test": "tsx test/run-tests.ts",
    "test:coverage": "c8 --config .c8rc.json tsx test/run-tests.ts",
    "test:matrix": "tsx test/policy-matrix.test.ts",
    "test:e2e": "tsx test/runtime-e2e.test.ts",
    "prepack": "tsc -p tsconfig.build.json"
  }
}
